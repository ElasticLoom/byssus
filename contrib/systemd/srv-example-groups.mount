# Example: make /srv/example/groups a shared propagation anchor at boot.
#
# The unit file name must match the mount point (systemd-escape --path).
# Install as /etc/systemd/system/srv-example-groups.mount and enable it. Target
# roots of Byssus groups live beneath this directory.

[Unit]
Description=Byssus propagation anchor for /srv/example/groups
Before=byssusd.service

[Mount]
What=/srv/example/groups
Where=/srv/example/groups
Type=none
# "shared" is applied by mount(8) after the bind mount is created.
Options=bind,shared

[Install]
WantedBy=local-fs.target
RequiredBy=byssusd.service
